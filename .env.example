# Copialo a .env y ajustá los valores.

# Gateway del backend: destino del proxy de /api en desarrollo y de los tests de red.
TICKETYA_GATEWAY_URL=http://localhost:8080

# Puerto del dev server. 5173 cae en un rango reservado de Windows (Docker/WSL2).
TICKETYA_DEV_PORT=5273

# Client id de OAuth de Google Cloud (tipo "Aplicación web", origen http://localhost:5273).
# Es el mismo GOOGLE_CLIENT_ID del backend y no es secreto. Vacío: el login muestra solo el usuario de prueba.
TICKETYA_GOOGLE_CLIENT_ID=
